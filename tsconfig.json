{
  "compilerOptions": {
    // Environment Settings
    "module": "esnext",                  // Change from nodenext to esnext
    "moduleResolution": "bundler",       // Add this to allow standard imports
    "target": "esnext",
    "types": ["node"],                  // Highly recommended to explicitly add node types for a CLI

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "noEmit": true,                      // Essential when using 'bundler' + running directly via tsx/ts-node

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}